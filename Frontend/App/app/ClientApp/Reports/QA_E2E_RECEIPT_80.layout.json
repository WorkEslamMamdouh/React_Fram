{
  "schema": "rf-report/1",
  "code": "QA_E2E_RECEIPT_80",
  "nameAr": "إيصال مطعم QA 80 مم",
  "nameEn": "QA restaurant receipt 80mm",
  "kind": "document",
  "page": {
    "size": "Thermal80",
    "margins": {
      "top": 3,
      "right": 4,
      "bottom": 4,
      "left": 4
    },
    "dir": "auto"
  },
  "data": {
    "source": {
      "type": "proc",
      "name": "dbo.QA_E2E_Rpt_RestReceipt"
    },
    "params": [
      {
        "name": "TrID",
        "from": "row",
        "value": "OrderID"
      }
    ],
    "tables": {
      "Data": "header",
      "Data2": "lines"
    }
  },
  "styles": {
    "base": {
      "size": 8.5,
      "color": "#000000"
    },
    "th": {
      "size": 8,
      "bold": true,
      "background": "#ffffff",
      "border": {
        "bottom": true
      },
      "borderColor": "#000000"
    },
    "td": {
      "size": 8
    },
    "total": {
      "size": 8.5,
      "bold": true,
      "background": "#ffffff"
    }
  },
  "bands": [
    {
      "type": "reportHeader",
      "style": {
        "align": "center"
      },
      "elements": [
        {
          "type": "image",
          "src": "Company.LogoBase64",
          "height": 14,
          "visibleIf": "Company.LogoBase64 <> ''"
        },
        {
          "type": "text",
          "text": {
            "ar": "{{Company.CompNameA}}",
            "en": "{{coalesce(Company.CompNameE, Company.CompNameA)}}"
          },
          "style": {
            "size": 11,
            "bold": true,
            "align": "center"
          }
        },
        {
          "type": "text",
          "text": "{{Company.BranchNameA}} {{Company.BranchAddress}}",
          "style": {
            "size": 7.5,
            "align": "center"
          }
        },
        {
          "type": "text",
          "visibleIf": "Company.VatNo <> ''",
          "text": {
            "ar": "الرقم الضريبي {{Company.VatNo}}",
            "en": "VAT {{Company.VatNo}}"
          },
          "style": {
            "size": 7.5,
            "align": "center"
          }
        },
        {
          "type": "line",
          "dashed": true,
          "thickness": 0.2,
          "color": "#000000"
        },
        {
          "type": "text",
          "text": {
            "ar": "طلب {{header.OrderNo}} - ترابيزة {{coalesce(header.TableNo, 'تيك أواي')}}",
            "en": "Order {{header.OrderNo}} - Table {{coalesce(header.TableNo, 'Takeaway')}}"
          },
          "style": {
            "bold": true,
            "align": "center"
          }
        },
        {
          "type": "row",
          "gap": 1,
          "items": [
            {
              "type": "text",
              "width": "50%",
              "text": {
                "ar": "رقم: {{header.OrderNo}}",
                "en": "No: {{header.OrderNo}}"
              }
            },
            {
              "type": "text",
              "width": "50%",
              "text": "{{header.CreatedAt | dateTime}}",
              "style": {
                "align": "end"
              }
            }
          ]
        },
        {
          "type": "text",
          "visibleIf": "header.Waiter <> ''",
          "text": {
            "ar": "الويتر: {{header.Waiter}}",
            "en": "Waiter: {{header.Waiter}}"
          }
        },
        {
          "type": "line",
          "dashed": true,
          "thickness": 0.2,
          "color": "#000000"
        }
      ]
    },
    {
      "type": "detail",
      "table": "lines",
      "layout": "table",
      "columns": [
        {
          "expr": "if(lang = 'en', ItemNameEn, ItemNameAr)",
          "title": {
            "ar": "الصنف",
            "en": "Item"
          },
          "width": "46%"
        },
        {
          "field": "Qty",
          "title": {
            "ar": "كمية",
            "en": "Qty"
          },
          "width": "14%",
          "format": "n0",
          "align": "center"
        },
        {
          "field": "Price",
          "title": {
            "ar": "سعر",
            "en": "Price"
          },
          "width": "18%",
          "format": "n2",
          "align": "end"
        },
        {
          "field": "LineTotal",
          "title": {
            "ar": "قيمة",
            "en": "Amount"
          },
          "width": "22%",
          "format": "n2",
          "align": "end"
        }
      ]
    },
    {
      "type": "reportFooter",
      "elements": [
        {
          "type": "line",
          "dashed": true,
          "thickness": 0.2,
          "color": "#000000"
        },
        {
          "type": "row",
          "items": [
            {
              "type": "text",
              "width": "60%",
              "text": {
                "ar": "عدد الأصناف",
                "en": "Items"
              }
            },
            {
              "type": "expression",
              "width": "40%",
              "expr": "count()",
              "style": {
                "align": "end"
              }
            }
          ]
        },
        {
          "type": "row",
          "items": [
            {
              "type": "text",
              "width": "60%",
              "text": {
                "ar": "الإجمالي",
                "en": "Subtotal"
              }
            },
            {
              "type": "expression",
              "width": "40%",
              "expr": "header.SubTotal",
              "format": "n2",
              "style": {
                "align": "end"
              }
            }
          ]
        },
        {
          "type": "row",
          "items": [
            {
              "type": "text",
              "width": "60%",
              "text": {
                "ar": "الخدمة {{header.ServicePct | n0}}%",
                "en": "Service {{header.ServicePct | n0}}%"
              }
            },
            {
              "type": "expression",
              "width": "40%",
              "expr": "header.Service",
              "format": "n2",
              "style": {
                "align": "end"
              }
            }
          ]
        },
        {
          "type": "row",
          "items": [
            {
              "type": "text",
              "width": "60%",
              "text": {
                "ar": "الضريبة",
                "en": "VAT"
              }
            },
            {
              "type": "expression",
              "width": "40%",
              "expr": "header.Tax",
              "format": "n2",
              "style": {
                "align": "end"
              }
            }
          ]
        },
        {
          "type": "row",
          "style": {
            "bold": true,
            "size": 11
          },
          "items": [
            {
              "type": "text",
              "width": "60%",
              "text": {
                "ar": "الصافي",
                "en": "TOTAL"
              }
            },
            {
              "type": "expression",
              "width": "40%",
              "expr": "header.Total",
              "format": "n2",
              "style": {
                "align": "end"
              }
            }
          ]
        },
        {
          "type": "amountWords",
          "value": "header.Total",
          "currency": "EGP",
          "prefix": {
            "ar": "فقط",
            "en": ""
          },
          "suffix": {
            "ar": "لا غير",
            "en": ""
          },
          "style": {
            "size": 7.5,
            "align": "center"
          }
        },
        {
          "type": "line",
          "dashed": true,
          "thickness": 0.2,
          "color": "#000000"
        },
        {
          "type": "qr",
          "size": 32,
          "value": "zatcaQr(Company.CompNameA, Company.VatNo, header.CreatedAt, header.Total, header.Tax)",
          "style": {
            "align": "center"
          }
        },
        {
          "type": "barcode",
          "value": "header.OrderNo",
          "format": "CODE128",
          "barHeight": 9,
          "showText": true
        },
        {
          "type": "text",
          "text": {
            "ar": "شكرًا لزيارتكم",
            "en": "Thank you for your visit"
          },
          "style": {
            "align": "center",
            "bold": true
          }
        },
        {
          "type": "text",
          "text": "{{Company.PrintedAt}}",
          "style": {
            "align": "center",
            "size": 7
          }
        }
      ]
    }
  ]
}
