{
  "schema": "rf-report/1",
  "code": "QA_E2E_INV_A4",
  "nameAr": "فاتورة مبيعات QA (A4)",
  "nameEn": "QA sales invoice (A4)",
  "kind": "document",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 10,
      "right": 10,
      "bottom": 10,
      "left": 10
    },
    "dir": "auto"
  },
  "data": {
    "source": {
      "type": "proc",
      "name": "dbo.QA_E2E_Rpt_SalesInvoice"
    },
    "params": [
      {
        "name": "TrID",
        "from": "row",
        "value": "SaleID"
      }
    ],
    "tables": {
      "Data": "header",
      "Data2": "lines"
    }
  },
  "styles": {
    "base": {
      "size": 9.5,
      "color": "#0b1c30"
    },
    "th": {
      "size": 9,
      "bold": true,
      "background": "#1f3a5f",
      "color": "#ffffff"
    },
    "td": {
      "size": 9
    },
    "total": {
      "size": 9.5,
      "bold": true,
      "background": "#eef2f7"
    }
  },
  "bands": [
    {
      "type": "reportHeader",
      "elements": [
        {
          "type": "row",
          "gap": 4,
          "items": [
            {
              "type": "image",
              "src": "Company.LogoBase64",
              "width": 24,
              "height": 20
            },
            {
              "type": "text",
              "width": "52%",
              "text": {
                "ar": "{{Company.CompNameA}}",
                "en": "{{coalesce(Company.CompNameE, Company.CompNameA)}}"
              },
              "style": {
                "size": 15,
                "bold": true,
                "color": "#1f3a5f"
              }
            },
            {
              "type": "text",
              "width": "30%",
              "text": {
                "ar": "فاتورة ضريبية",
                "en": "TAX INVOICE"
              },
              "style": {
                "size": 15,
                "bold": true,
                "align": "end",
                "color": "#1f3a5f"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": {
            "ar": "{{Company.BranchNameA}} · {{Company.BranchAddress}} · هاتف: {{coalesce(Company.BranchTel, Company.CompTel)}}",
            "en": "{{coalesce(Company.BranchNameE, Company.BranchNameA)}} · {{Company.BranchAddress}} · Tel: {{coalesce(Company.BranchTel, Company.CompTel)}}"
          },
          "style": {
            "size": 8.5,
            "color": "#475569"
          }
        },
        {
          "type": "text",
          "visibleIf": "Company.VatNo <> ''",
          "text": {
            "ar": "الرقم الضريبي: {{Company.VatNo}}",
            "en": "VAT No: {{Company.VatNo}}"
          },
          "style": {
            "size": 8.5,
            "color": "#475569"
          }
        },
        {
          "type": "line",
          "thickness": 0.6,
          "color": "#1f3a5f"
        },
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "row",
          "gap": 4,
          "items": [
            {
              "type": "rect",
              "width": "49%",
              "style": {
                "border": true,
                "radius": 1.5,
                "padding": 2.5,
                "borderColor": "#cbd5e1"
              },
              "text": {
                "ar": "العميل: {{coalesce(header.CustomerNameAr, 'نقدي')}}\nالجوال: {{header.CustomerPhone}}",
                "en": "Customer: {{coalesce(header.CustomerNameAr, 'Cash')}}\nMobile: {{header.CustomerPhone}}"
              }
            },
            {
              "type": "rect",
              "width": "49%",
              "style": {
                "border": true,
                "radius": 1.5,
                "padding": 2.5,
                "borderColor": "#cbd5e1"
              },
              "text": {
                "ar": "رقم الفاتورة: {{header.InvoiceNo}}\nالتاريخ: {{header.SaleDate | date}}\nطريقة الدفع: {{header.PaymentNameAr}}",
                "en": "Invoice No: {{header.InvoiceNo}}\nDate: {{header.SaleDate | date}}\nPayment: {{header.PaymentNameEn}}"
              }
            }
          ]
        },
        {
          "type": "spacer",
          "height": 3
        }
      ]
    },
    {
      "type": "pageHeader",
      "skipFirstPage": true,
      "elements": [
        {
          "type": "text",
          "text": {
            "ar": "{{Company.CompNameA}} — فاتورة رقم {{header.InvoiceNo}} (تابع)",
            "en": "{{coalesce(Company.CompNameE, Company.CompNameA)}} — Invoice {{header.InvoiceNo}} (continued)"
          },
          "style": {
            "size": 8.5,
            "color": "#475569"
          }
        },
        {
          "type": "spacer",
          "height": 2
        }
      ]
    },
    {
      "type": "detail",
      "table": "lines",
      "layout": "table",
      "zebra": true,
      "showTotals": true,
      "columns": [
        {
          "expr": "rowNumber",
          "title": {
            "ar": "#",
            "en": "#"
          },
          "width": "6%",
          "align": "center"
        },
        {
          "field": "ItemCode",
          "title": {
            "ar": "الكود",
            "en": "Code"
          },
          "width": "12%"
        },
        {
          "expr": "if(lang = 'en', ItemNameEn, ItemNameAr)",
          "title": {
            "ar": "الصنف",
            "en": "Item"
          },
          "width": "40%"
        },
        {
          "field": "Qty",
          "title": {
            "ar": "الكمية",
            "en": "Qty"
          },
          "width": "9%",
          "format": "n2",
          "align": "end",
          "aggregate": "sum"
        },
        {
          "field": "Price",
          "title": {
            "ar": "السعر",
            "en": "Price"
          },
          "width": "11%",
          "format": "n2",
          "align": "end"
        },
        {
          "field": "LineTotal",
          "title": {
            "ar": "الإجمالي",
            "en": "Total"
          },
          "width": "22%",
          "format": "n2",
          "align": "end",
          "aggregate": "sum"
        }
      ]
    },
    {
      "type": "reportFooter",
      "elements": [
        {
          "type": "spacer",
          "height": 3
        },
        {
          "type": "row",
          "gap": 4,
          "items": [
            {
              "type": "qr",
              "width": 32,
              "size": 30,
              "value": "zatcaQr(Company.CompNameA, Company.VatNo, header.SaleDate, header.NetAmount, header.VatAmount)"
            },
            {
              "type": "rect",
              "width": "40%",
              "style": {
                "border": false,
                "padding": 0,
                "size": 9
              },
              "text": {
                "ar": "ملاحظات: {{header.Remarks}}",
                "en": "Notes: {{header.Remarks}}"
              }
            },
            {
              "type": "row",
              "direction": "column",
              "width": "38%",
              "gap": 0,
              "style": {
                "border": true,
                "borderColor": "#cbd5e1",
                "radius": 1.5,
                "padding": 1.5
              },
              "items": [
                {
                  "type": "row",
                  "items": [
                    {
                      "type": "text",
                      "width": "58%",
                      "text": {
                        "ar": "الإجمالي قبل الخصم",
                        "en": "Subtotal"
                      }
                    },
                    {
                      "type": "expression",
                      "width": "42%",
                      "expr": "header.TotalAmount",
                      "format": "n2",
                      "style": {
                        "align": "end"
                      }
                    }
                  ]
                },
                {
                  "type": "row",
                  "items": [
                    {
                      "type": "text",
                      "width": "58%",
                      "text": {
                        "ar": "الخصم",
                        "en": "Discount"
                      }
                    },
                    {
                      "type": "expression",
                      "width": "42%",
                      "expr": "header.Discount",
                      "format": "n2",
                      "style": {
                        "align": "end"
                      }
                    }
                  ]
                },
                {
                  "type": "row",
                  "items": [
                    {
                      "type": "text",
                      "width": "58%",
                      "text": {
                        "ar": "ضريبة القيمة المضافة",
                        "en": "VAT"
                      }
                    },
                    {
                      "type": "expression",
                      "width": "42%",
                      "expr": "header.VatAmount",
                      "format": "n2",
                      "style": {
                        "align": "end"
                      }
                    }
                  ]
                },
                {
                  "type": "line",
                  "thickness": 0.2,
                  "color": "#cbd5e1"
                },
                {
                  "type": "row",
                  "style": {
                    "bold": true,
                    "size": 11,
                    "color": "#1f3a5f"
                  },
                  "items": [
                    {
                      "type": "text",
                      "width": "58%",
                      "text": {
                        "ar": "الصافي",
                        "en": "Net total"
                      }
                    },
                    {
                      "type": "expression",
                      "width": "42%",
                      "expr": "header.NetAmount",
                      "format": "n2",
                      "style": {
                        "align": "end"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "amountWords",
          "value": "header.NetAmount",
          "currency": "EGP",
          "prefix": {
            "ar": "فقط",
            "en": "Only"
          },
          "suffix": {
            "ar": "لا غير",
            "en": ""
          },
          "style": {
            "bold": true,
            "background": "#f1f5f9",
            "padding": 2,
            "radius": 1
          }
        },
        {
          "type": "spacer",
          "height": 10
        },
        {
          "type": "row",
          "gap": 10,
          "items": [
            {
              "type": "signature",
              "width": "30%",
              "label": {
                "ar": "المستلم",
                "en": "Received by"
              }
            },
            {
              "type": "signature",
              "width": "30%",
              "label": {
                "ar": "المحاسب",
                "en": "Accountant"
              }
            },
            {
              "type": "signature",
              "width": "30%",
              "label": {
                "ar": "المدير",
                "en": "Manager"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "pageFooter",
      "elements": [
        {
          "type": "line",
          "thickness": 0.2,
          "color": "#cbd5e1"
        },
        {
          "type": "row",
          "items": [
            {
              "type": "text",
              "width": "50%",
              "text": {
                "ar": "طُبع: {{Company.PrintedAt}} بواسطة {{Company.PrintedBy}}",
                "en": "Printed: {{Company.PrintedAt}} by {{Company.PrintedBy}}"
              },
              "style": {
                "size": 7.5,
                "color": "#64748b"
              }
            },
            {
              "type": "pageNumber",
              "width": "50%",
              "style": {
                "size": 7.5,
                "color": "#64748b",
                "align": "end"
              }
            }
          ]
        }
      ]
    }
  ]
}
